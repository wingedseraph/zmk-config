#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3

&lt { quick_tap_ms = <200>; };

&mt {
    quick_tap_ms = <200>;
    tapping-term-ms = <200>;
};

/ {
    behaviors {
        hold_tap: hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
          &kp ESC         &kp N1  &kp N2     &kp N3     &kp N4                &kp N5              &kp N6           &kp N7          &kp N8     &kp N9            &kp N0    &kp MINUS
&kp LWIN  &kp TAB         &kp Q   &kp W      &kp E      &kp R                 &kp T               &kp Y            &kp U           &kp I      &kp O             &kp P     &kp LBKT       &mt RWIN RBKT
          &kp LEFT_SHIFT  &kp A   &kp S      &kp D      &kp F                 &kp G               &kp H            &kp J           &kp K      &kp L             &kp SEMI  &mt RCTRL SQT
          &kp LALT        &kp Z   &kp X      &kp C      &kp V                 &kp B               &kp N            &kp M           &kp COMMA  &kp DOT           &kp FSLH  &mt RALT BSLH
                                  &kp LCTRL  &kp LMETA  &mt LEFT_SHIFT SPACE  &mt LEFT_ALT RET    &lt 1 BACKSPACE  &mt RSHFT BSPC  &mo 2      &kp LS(LEFT_ALT)
            >;
        };

        lower_layer {
            bindings = <
        &kp GRAVE       &kp F1  &kp F2     &kp F3                &kp F4                &kp F5                   &kp F6                             &kp F7                               &kp F8                      &kp F9                  &kp F10  &kp F11
&trans  &kp UNDER       &trans  &kp EQUAL  &kp MINUS             &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS    &kp LEFT_PARENTHESIS               &kp RIGHT_PARENTHESIS                &hold_tap UNDERSCORE MINUS  &hold_tap PLUS EQUAL    &trans   &trans   &kp F12
        &mt LCTRL PLUS  &trans  &kp DEL    &kp NON_US_BACKSLASH  &kp LEFT_BRACKET      &kp RIGHT_BRACKET        &hold_tap LEFT_BRACE LEFT_BRACKET  &hold_tap RIGHT_BRACE RIGHT_BRACKET  &hold_tap PIPE BACKSLASH    &hold_tap CLEAR DELETE  &trans   &trans
        &mt LALT EQUAL  &trans  &trans     &trans                &kp SEMICOLON         &kp SQT                  &hold_tap COLON SEMICOLON          &hold_tap DOUBLE_QUOTES SQT          &trans                      &trans                  &trans   &trans
                                &trans     &lt 3 TAB             &trans                &trans                   &trans                             &trans                               &lt 3 DEL                   &trans
            >;
        };

        raise_layer {
            bindings = <
        &trans           &trans           &trans     &trans     &trans     &trans          &trans        &trans          &trans            &trans      &trans           &trans
&trans  &kp KP_NUM       &kp KP_SLASH     &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_MINUS    &kp C_VOL_UP  &kp K_PREVIOUS  &kp K_PLAY_PAUSE  &kp K_NEXT  &kp SLCK         &trans           &trans
        &mt LCTRL EQUAL  &kp KP_MULTIPLY  &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_PLUS     &kp LEFT      &kp DOWN        &kp UP            &kp RIGHT   &kp INS          &mt RCTRL K_APP
        &trans           &kp KP_N0        &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_DOT      &kp C_VOL_DN  &kp END         &trans            &kp PG_DN   &kp PAUSE_BREAK  &trans
                                          &trans     &trans     &trans     &lt 3 RET       &lt 3 ESC     &trans          &trans            &trans
            >;
        };

        adjust_layer {
            bindings = <
       &none        &none         &none         &none         &none         &none           &none         &none         &none         &none         &none         &none
&none  &bootloader  &none         &none         &none         &none         &none           &none         &none         &none         &none         &none         &bootloader  &none
       &bt BT_CLR   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &bt BT_CLR
       &sys_reset   &none         &none         &none         &none         &none           &none         &none         &none         &none         &none         &sys_reset
                                  &none         &trans        &none         &trans          &trans        &none         &trans        &none
            >;
        };
    };
};
