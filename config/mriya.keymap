#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3

&lt { quick_tap_ms = <200>; };

&mt {
    quick_tap_ms = <200>;
    tapping-term-ms = <150>;
    flavor = "tap-preferred";
    bindings = <&sk>, <&kp>;
};

/ {
    behaviors {
        hold_tap: hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        ctrl_enter: ctrl_enter {
            compatible = "zmk,behavior-hold-tap";
            label = "CTRL_ENTER";
            bindings = <&sk>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };
    };

    combos {
        compatible = "zmk,combos";

        enter {
            bindings = <&kp ENTER>;
            key-positions = <33 34 35>;
        };

        bracket {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <32 33>;
            timeout-ms = <35>;
        };

        bracket2 {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <19 20>;
            timeout-ms = <45>;
        };

        quotes {
            bindings = <&kp SQT>;
            key-positions = <44 45>;
            timeout-ms = <35>;
        };

        equal {
            bindings = <&kp EQUAL>;
            key-positions = <30 31>;
            timeout-ms = <45>;
        };

        plus {
            bindings = <&kp PLUS>;
            key-positions = <17 18>;
            timeout-ms = <35>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
          &kp ESC         &kp N1  &kp N2  &kp N3        &kp N4                &kp N5                &kp N6  &kp N7          &kp N8     &kp N9            &kp N0    &kp MINUS
&kp LWIN  &kp TAB         &kp Q   &kp W   &kp E         &kp R                 &kp T                 &kp Y   &kp U           &kp I      &kp O             &kp P     &kp LBKT       &mt RWIN RBKT
          &kp LEFT_SHIFT  &kp A   &kp S   &kp D         &kp F                 &kp G                 &kp H   &kp J           &kp K      &kp L             &kp SEMI  &mt RCTRL SQT
          &kp LALT        &kp Z   &kp X   &kp C         &kp V                 &kp B                 &kp N   &kp M           &kp COMMA  &kp DOT           &kp FSLH  &mt RALT BSLH
                                  &mo 4   &kp LEFT_ALT  &mt LEFT_SHIFT SPACE  &mt LEFT_WIN ENTER    &mo 1   &mt RSHFT BSPC  &mo 2      &kp LS(LEFT_ALT)
            >;
        };

        lower_layer {
            bindings = <
        &kp GRAVE       &kp F1    &kp F2         &kp F3                &kp F4                &kp F5                   &kp F6                &kp F7          &kp F8                    &kp F9            &kp F10  &kp F11
&trans  &kp UNDER       &kp PLUS  &kp EQUAL      &kp MINUS             &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS    &kp LEFT_PARENTHESIS  &kp UNDERSCORE  &kp EQUAL                 &kp PLUS          &trans   &trans   &kp F12
        &mt LCTRL PLUS  &kp PIPE  &kp LS(LG(S))  &kp NON_US_BACKSLASH  &kp RIGHT_BRACE       &kp RIGHT_BRACKET        &kp LEFT_BRACKET      &kp LEFT_BRACE  &hold_tap PIPE BACKSLASH  &kp DELETE        &trans   &trans
        &mt LALT EQUAL  &trans    &trans         &trans                &kp DOUBLE_QUOTES     &kp COLON                &kp SEMICOLON         &kp SQT         &kp LESS_THAN             &kp GREATER_THAN  &trans   &trans
                                  &trans         &kp LEFT_ALT          &trans                &trans                   &trans                &trans          &lt 3 DEL                 &trans
            >;
        };

        raise_layer {
            bindings = <
       &trans  &kp LA(NUMBER_1)  &kp LA(NUMBER_2)  &kp LA(NUMBER_3)  &kp LA(NUMBER_4)      &kp LA(N5)    &kp LA(NUMBER_6)  &kp LA(N7)        &kp LA(NUMBER_8)  &trans            &trans            &trans
&sl 3  &none   &kp LA(Q)         &kp LA(W)         &kp LA(E)         &kp LA(R)             &kp LA(T)     &kp C_VOL_UP      &kp LA(U)         &kp LA(I)         &kp LA(O)         &kp K_PLAY_PAUSE  &none            &sl 3
       &none   &kp LA(A)         &kp LA(S)         &kp LA(D)         &kp LA(F)             &kp LA(G)     &kp LEFT          &kp DOWN          &kp UP            &kp RIGHT         &kp K_PREV        &mt RCTRL K_APP
       &trans  &kp LA(Z)         &kp LA(X)         &kp LA(C)         &kp LA(V)             &kp LA(B)     &kp C_VOL_DN      &kp K_PLAY_PAUSE  &kp LESS_THAN     &kp GREATER_THAN  &kp K_NEXT        &trans
                                 &kp LCTRL         &kp LEFT_SHIFT    &mt LEFT_SHIFT SPACE  &lt 3 RET     &kp BACKSPACE     &kp LEFT_SHIFT    &trans            &none
            >;
        };

        adjust_layer {
            bindings = <
       &none        &none         &none         &none         &none         &none           &none         &none         &none         &none         &none         &none
&none  &bootloader  &none         &none         &none         &none         &none           &none         &none         &none         &none         &none         &bootloader  &none
       &bt BT_CLR   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &bt BT_CLR
       &sys_reset   &none         &none         &none         &none         &none           &none         &none         &none         &none         &none         &sys_reset
                                  &none         &trans        &none         &trans          &trans        &none         &trans        &none
            >;
        };

        layer_4 {
            bindings = <
        &trans  &kp LG(NUMBER_1)  &kp LG(NUMBER_2)  &kp LG(NUMBER_3)  &kp LG(NUMBER_4)  &kp LG(N5)       &kp LG(NUMBER_6)  &kp LG(N7)  &kp LG(N8)     &kp LG(N9)   &kp LC(MINUS)  &kp LC(EQUAL)
&trans  &trans  &kp LC(Q)         &kp LC(W)         &kp LC(E)         &kp LC(R)         &kp LC(T)        &kp LC(Y)         &kp LC(U)   &kp LC(I)      &kp LC(O)    &kp LC(P)      &trans         &trans
        &trans  &kp LC(A)         &kp LC(S)         &kp LC(D)         &kp LC(F)         &kp LC(G)        &kp LC(H)         &kp LC(J)   &kp LC(K)      &kp LC(L)    &kp LC(SEMI)   &trans
        &trans  &kp LC(Z)         &kp LC(X)         &kp LC(C)         &kp LC(V)         &kp LC(B)        &kp LC(N)         &kp LC(M)   &kp LC(COMMA)  &kp LC(DOT)  &kp LC(FSLH)   &trans
                                  &trans            &kp LMETA         &trans            &kp LG(ENTER)    &trans            &trans      &trans         &trans
            >;
        };
    };
};
